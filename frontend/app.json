{
  "expo": {
    "name": "USAHORA",
    "slug": "usahora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "usahora",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.usahorapwa.qvqya3",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcode produk untuk kasir lebih cepat",
        "NSPhotoLibraryUsageDescription": "Pilih foto produk dan logo usaha"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.emergent.usahorapwa.qvqya3",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "USAHORA",
      "shortName": "USAHORA",
      "themeColor": "#2563EB",
      "backgroundColor": "#F8FAFC",
      "description": "Business Management System for UMKM"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/lucide",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan barcode produk untuk kasir lebih cepat",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto produk dan logo usaha"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}